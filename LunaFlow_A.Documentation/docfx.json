{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "**/*.csproj" ],
          "exclude": [ "**/*Test*.csproj" ]
        }
      ],
      "dest": "api"
    }
  ],
"build": {
  "content": [
    { "files": [ "toc.yml", "index.md" ] },
    { "files": [ "api/**.yml", "api/index.md" ] },
    { "files": [ "docs/**.yml", "docs/**.md" ] }
  ],
  "resource": [
    {
      "src": "docs",
      "files": [ "**/*.txt" ],
      "dest": "docs"
    },
    {
      "src": "../assets",
      "files": [ "LunaFlowLogoSmall.png" ],
      "dest": "."
    }
  ],
  "globalMetadata": {
    "_appLogoPath": "LunaFlowLogoSmall.png"
  },
  "overwrite": [],
  "template": [ "templates/nojs"  ],
  "dest": "../docs"
}

}

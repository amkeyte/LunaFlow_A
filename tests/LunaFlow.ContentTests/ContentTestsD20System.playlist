  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.SessionStart_AnnouncesRoom5Description_BeforeMonsterDesc" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Fight_LethalPcHit_AnnouncesMonsterDefeatedOnly_SolvesRoom_SkipsCounterattack" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Fight_LethalMonsterHit_AcrossTwoRounds_AnnouncesPcLostOnly_FailsRoom_SessionContinues" />

  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Fight_FreshRound_SeedsBothCombatantsAtMaxHp_NoCarryoverAfterFlee" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Fight_EveryRound_AnnouncesSomething" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Look_DuringActiveCombatRound_ReportsBothCombatantsHp" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Check_RoomSpecificSuccess_AnnouncesTextAndReadout_SolvesOnce_NoRePrompt" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Check_Failure_LeavesRoomUnsolved_RetryableWithNoPenalty" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Flee_DuringActiveCombat_RetractsCleanly_NoSolveNoFail_ReturnsToPreviousRoom" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Flee_Room5_NoPriorMove_DoesNotMoveOrThrow" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Win_CombatFreeColumn_FiresWinMarkerAndGameEnd" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Win_LineIncludingCombatRoom_FiresWinMarker_WhenSolvedViaFight" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemRuleFixtureTests.ChallengePrompt_SkillCheckRoom_AnnouncesPromptKey_WhileUnsolvedAndUnfailed" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemRuleFixtureTests.ChallengePrompt_FightRoom_AnnouncesMonsterDesc" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemRuleFixtureTests.ChallengePrompt_RoomSolved_StopsAnnouncing" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemRuleFixtureTests.ChallengePrompt_RoomFailed_StopsAnnouncing" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemRuleFixtureTests.ChallengePrompt_AfterWinMarker_StopsAnnouncing_EvenForUnrelatedUnsolvedRoom" />

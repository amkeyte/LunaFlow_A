<?xml version="1.0" encoding="utf-8"?>
<Playlist Version="2.0">
  <!-- Rom/D20System: handler-level (move/look/check/fight/flee, 16 tests) + -->
  <!-- rule-fixture-level (challenge-prompt guards, win-line firing, 9 tests) = 25 tests -->
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Move_MatchesNineRoomsAdjacency_ValidAndRejected" />
  <Rule Name="Include" FullyQualifiedName="LunaFlow.ContentTests.Rom.D20System.D20SystemHandlerTests.Move_TracksPreviousRoomId_UpdatingOnEachSuccessfulMove" />

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaFlow.Engine\LunaFlow.Engine.csproj" />
    <ProjectReference Include="..\LunaFlow.Rom\LunaFlow.Rom.csproj" />
    <ProjectReference Include="..\..\example\D20SystemExampleA\D20SystemExampleA.csproj" />
  </ItemGroup>

  <Target Name="GenerateApiReference" AfterTargets="Build">
    <Exec Command="dotnet defaultdocumentation --AssemblyFilePath &quot;$(TargetPath)&quot; --OutputDirectoryPath &quot;$(MSBuildThisFileDirectory)..\..\Documents\ApiReference\$(MSBuildProjectName)&quot; --GeneratedAccessModifiers Public --IncludeUndocumentedItems --FileNameFactory DirectoryName" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

</Project>

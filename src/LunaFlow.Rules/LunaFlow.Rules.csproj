<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="NRules" Version="1.0.2" />
  </ItemGroup>

  <Target Name="GenerateApiReference" AfterTargets="Build">
    <Exec Command="dotnet defaultdocumentation --AssemblyFilePath &quot;$(TargetPath)&quot; --OutputDirectoryPath &quot;$(MSBuildThisFileDirectory)..\..\Documents\ApiReference\$(MSBuildProjectName)&quot; --GeneratedAccessModifiers Public --IncludeUndocumentedItems --FileNameFactory DirectoryName" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

</Project>

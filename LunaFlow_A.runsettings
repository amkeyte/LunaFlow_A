<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins test-result output for the agent-test-workflow (Documents/ClaudeWiki/Processes/agent-test-workflow.md).
  Every run, from VS2022 Test Explorer or "dotnet test", writes a TRX to the same known path
  so the agent doesn't need to be told where to look.

  VS2022: Test menu, Configure Run Settings, Select Solution-Wide runsettings File, this file.
  CLI:    dotnet test tests/LunaFlow.EngineTests with the "settings" option pointed at this file.
-->
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>tests/LunaFlow.EngineTests/TestResults</ResultsDirectory>
  </RunConfiguration>
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="trx" enabled="True">
        <Configuration>
          <LogFileName>latest.trx</LogFileName>
        </Configuration>
      </Logger>
    </Loggers>
  </LoggerRunSettings>
</RunSettings>
